{
  "name": "@stxonector/core",
  "description": "sBTC deposit, signer, quote and reclaim logic. No UI, no keys.",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@scure/base": "1.2.6",
    "@scure/btc-signer": "1.8.1",
    "@stacks/transactions": "7.7.0",
    "sbtc": "0.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stxonector/prettier-config": "workspace:*",
    "@stxonector/tsconfig-config": "workspace:*",
    "prettier": "3.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "main": "./src/index.ts",
  "prettier": "@stxonector/prettier-config",
  "private": true,
  "types": "./src/index.ts"
}
