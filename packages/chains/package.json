{
  "name": "@satway/chains",
  "description": "EVM transfers, sends and send records for the origin chain. No UI, no browser globals.",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@satway/core": "workspace:*"
  },
  "devDependencies": {
    "@satway/prettier-config": "workspace:*",
    "@satway/tsconfig-config": "workspace:*",
    "prettier": "3.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "main": "./src/index.ts",
  "prettier": "@satway/prettier-config",
  "private": true,
  "types": "./src/index.ts"
}
