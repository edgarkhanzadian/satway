{
  "name": "@satway/panda-preset",
  "description": "Design tokens, recipes and global styles for the web app, as a Panda preset",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./config": "./src/preset.ts"
  },
  "dependencies": {
    "@pandacss/dev": "1.7.1"
  },
  "devDependencies": {
    "@satway/prettier-config": "workspace:*",
    "@satway/tsconfig-config": "workspace:*",
    "prettier": "3.5.1",
    "typescript": "5.9.3"
  },
  "prettier": "@satway/prettier-config",
  "private": true
}
