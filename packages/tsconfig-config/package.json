{
  "name": "@satway/tsconfig-config",
  "description": "Shared tsconfig configuration",
  "version": "0.0.0",
  "scripts": {
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@satway/prettier-config": "workspace:*",
    "prettier": "3.5.1"
  },
  "main": "tsconfig.base.json",
  "prettier": "@satway/prettier-config",
  "private": true
}
