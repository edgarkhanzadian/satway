{
  "name": "@portage/scripts",
  "description": "Mainnet proof scripts and the bundle safety check",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier . --write --ignore-path ../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@portage/core": "workspace:*",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@scure/btc-signer": "1.8.1",
    "@stacks/transactions": "7.7.0",
    "sbtc": "0.3.2"
  },
  "devDependencies": {
    "@portage/prettier-config": "workspace:*",
    "@portage/tsconfig-config": "workspace:*",
    "prettier": "3.5.1",
    "typescript": "5.9.3"
  },
  "prettier": "@portage/prettier-config",
  "private": true
}
