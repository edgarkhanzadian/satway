# Copy to .env.local (git-ignored). Never commit real values.

# --- apps/api (also set as a Worker secret: `wrangler secret put ONECLICK_JWT`)
# 1Click partner key from https://partners.near-intents.org. Optional, but
# without it every swap pays an extra 0.2% keyless fee.
ONECLICK_JWT=

# --- scripts/ (mainnet proofs). Use a throwaway wallet with small amounts.
# Stacks address that receives the sBTC from proof deposits.
TEST_STX_ADDRESS=
# WIF private key used as the reclaim key for proof deposits. It can only
# ever reclaim deposits that the signers did not process.
TEST_BTC_WIF=

# Optional: refund addresses echoed in dry-run quotes (no funds are sent).
TEST_REFUND_EVM=
TEST_REFUND_SOL=
TEST_REFUND_TRON=
