{
  "name": "@satway/web",
  "description": "Browser app: deposit flow, status tracking, recovery",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm codegen && vite build",
    "codegen": "panda codegen",
    "dev": "pnpm codegen && vite",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "pnpm codegen && eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepare": "pnpm codegen",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "pnpm codegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@satway/chains": "workspace:*",
    "@satway/core": "workspace:*",
    "@scure/base": "1.2.6",
    "@stacks/connect": "8.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@pandacss/dev": "1.7.1",
    "@satway/panda-preset": "workspace:*",
    "@satway/prettier-config": "workspace:*",
    "@satway/tsconfig-config": "workspace:*",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "prettier": "@satway/prettier-config",
  "private": true
}
